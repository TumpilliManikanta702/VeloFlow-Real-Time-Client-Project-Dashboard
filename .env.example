# ==========================================
# Environment Variables Example for VeloFlow
# ==========================================

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veloflow?schema=public

# Server Configuration
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# JWT Secrets (Use strong random 64-char strings in production)
JWT_ACCESS_SECRET=super_secret_access_jwt_key_veloflow_2026_dev_mode_change_in_prod
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_veloflow_2026_dev_mode_change_in_prod
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Logging & Monitoring
LOG_LEVEL=debug
